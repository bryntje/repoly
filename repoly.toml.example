# repoly.toml — multi-repo workspace for the repoly CLI
schema_version = 1

[workspace]
name = "acme"
# root = "."   # optional; defaults to directory of this file

[context]
always = ["docs/PLATFORM.md"]
# status_doc = "docs/STATUS.md"
max_chars = 48000

# Optional plan/ctx ranking tuning
# [ranking]
# synonym_groups = [
#   ["billing", "invoice", "stripe"],
# ]
# [[ranking.rewrites]]
# match = "invoice portal"
# add = ["billing", "stripe"]

[[repos]]
id = "api"
path = "./api"
role = "api"
tags = ["backend", "payments"]
description = "HTTP API"

[[repos]]
id = "web"
path = "./web"
role = "frontend"
tags = ["frontend"]
depends_on = ["api"]
description = "Web app"
# context_files = ["AGENTS.md", "CLAUDE.md", "README.md"]
