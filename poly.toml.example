# poly.toml — multi-repo workspace for the poly CLI
schema_version = 1

[workspace]
name = "acme"
# root = "."   # optional; defaults to directory of this file

[context]
always = ["docs/PLATFORM.md"]
# status_doc = "docs/STATUS.md"
max_chars = 48000

[[repos]]
id = "api"
path = "./api"
role = "api"
tags = ["backend", "payments"]
description = "HTTP API"

[[repos]]
id = "web"
path = "./web"
role = "frontend"
tags = ["frontend"]
depends_on = ["api"]
description = "Web app"
# context_files = ["AGENTS.md", "CLAUDE.md", "README.md"]
